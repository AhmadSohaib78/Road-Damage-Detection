# Environment Configuration Example

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Model Configuration
MODEL_PATH=outputs/weights/best.pt
MODEL_NAME=yolov8n
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# Data Configuration
DATA_YAML_PATH=outputs/yolo_dataset/data.yaml
DATASET_BASE_PATH=dataset/data

# Compute
DEVICE=cpu  # or 'cuda' if GPU available

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Frontend
FRONTEND_URL=http://localhost:3000
